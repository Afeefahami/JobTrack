# ---------------------------------------------------------------------------
# JobTrack environment variables
# Copy this file to `.env` (in the project root or in `backend/`) and edit it.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# SQLite file. The default is backend/jobtrack.db, so this line is optional.
DATABASE_URL=sqlite:///./jobtrack.db

# --- Security -------------------------------------------------------------
# REQUIRED for a stable login session. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS / URLs ----------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Used to build password-reset links printed in the backend console.
FRONTEND_URL=http://localhost:4200

# --- Optional AI-assisted extraction ---------------------------------------
# Leave OPTIONAL_AI_API_KEY empty to use only the built-in local extractor.
# When set, the AI result is used first and the local extractor fills any gaps.
OPTIONAL_AI_API_KEY=
# "anthropic" or "openai" (any OpenAI-compatible API)
AI_PROVIDER=anthropic
# Leave empty to use the provider default. Set it to the model you want to use.
AI_MODEL=
# Optional custom API base URL (proxy or OpenAI-compatible server).
AI_BASE_URL=
